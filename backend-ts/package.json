{
   "name": "typeorm",
   "version": "0.0.0",
   "private": true,
   "engines": {
      "node": "^22"
   },
   "scripts": {
      "dev": "nodemon --exec ts-node src/server.ts",
      "start": "NODE_ENV=production ts-node src/server.ts",
      "typeorm-old": "node --require ts-node/register ./node_modules/typeorm/cli.js",
      "typeorm": "npx typeorm -d dist/db/ormconfig.js",
      "migration:generate": "npm run typeorm -- migration:generate",
      "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/AppDataSource.ts",
      "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/AppDataSource.ts",
      "fresh": "ts-node src/database/fresh.ts",
      "fresh-test": "node --env-file=../.env.test -r ts-node/register ./src/database/fresh.ts",
      "seed": "ts-node src/database/seeds",
      "seed-test": "node --env-file=../.env.test -r ts-node/register ./src/database/seeds",
      "test": "NODE_ENV=test jest",
      "docker:test": "docker-compose -f ../docker-compose.test.yml run --rm test-backend-ts && docker-compose -f ../docker-compose.test.yml down -v",
      "docker:test-up": "docker-compose -f ../docker-compose.test.yml up --exit-code-from test-backend-ts --abort-on-container-exit && docker-compose -f ../docker-compose.test.yml down -v"
   },
   "dependencies": {
      "bcryptjs": "2.4.3",
      "cookie-parser": "1.4.4",
      "cors": "2.8.5",
      "debug": "2.6.9",
      "dotenv": "17.2.1",
      "express": "5.1.0",
      "jsonwebtoken": "9.0.2",
      "mongodb": "6.17.0",
      "nodemon": "2.0.15",
      "reflect-metadata": "0.2.2",
      "typeorm": "0.3.25",
      "validatorjs": "3.22.1"
   },
   "devDependencies": {
      "@faker-js/faker": "6.0.0-beta.0",
      "@types/cors": "2.8.19",
      "@types/express": "5.0.3",
      "@types/jest": "27.5.0",
      "@types/jsonwebtoken": "9.0.10",
      "@types/mongodb": "4.0.7",
      "@types/morgan": "1.9.10",
      "@types/node": "16.11.10",
      "@types/supertest": "6.0.3",
      "@types/validatorjs": "3.15.5",
      "jest": "28.1.0",
      "morgan": "1.10.1",
      "supertest": "7.1.4",
      "ts-jest": "28.0.2",
      "ts-node": "10.9.2",
      "tsconfig-paths": "4.2.0",
      "typescript": "4.5.2"
   },
   "jest": {
      "verbose": true,
      "testMatch": [
         "**/src/tests/**/*.ts"
      ],
      "roots": [
         "<rootDir>/src/tests"
      ],
      "transform": {
         "^.+\\.tsx?$": "ts-jest"
      },
      "modulePathIgnorePatterns": [
         "utils"
      ]
   }
}
