{
  "name": "frontend-vue3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:unit": "vitest run src/store/modules/__tests__",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.6.8",
    "core-js": "^3.37.0",
    "cypress": "^14.5.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "vue-tsc": "^3.0.5"
  }
}
